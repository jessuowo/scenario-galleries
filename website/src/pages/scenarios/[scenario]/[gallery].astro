---
import { scenarios } from "../../../data/scenarios.js";
import { site } from "../../../data/site.js";
import "../../../styles/theme.css";

export function getStaticPaths() {
  return scenarios.flatMap((scenario) =>
    scenario.galleries.map((gallery) => ({
      params: {
        scenario: scenario.slug,
        gallery: gallery.slug,
      },

      props: {
        scenarioTitle: scenario.title,
        scenarioSlug: scenario.slug,
        gallery,
      },
    }))
  );
}

const {
  scenarioTitle,
  scenarioSlug,
  gallery,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{gallery.title} | Scenario Galleries</title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">
        SCENARIO GALLERIES
      </a>

      <a href={`/scenarios/${scenarioSlug}`}>
        Scenario
      </a>
    </header>

    <main>
      <div class="breadcrumbs">
        <a href="/">Scenarios</a>
        <span>/</span>

        <a href={`/scenarios/${scenarioSlug}`}>
          {scenarioTitle}
        </a>

        <span>/</span>
        <span>{gallery.title}</span>
      </div>

      <section class="gallery-header">
        <div>
          <p class="eyebrow">
            {gallery.type.toUpperCase()}
          </p>

          <h1>{gallery.title}</h1>
        </div>

        <div class="count">
          <strong id="gallery-count">0</strong>
          <span id="gallery-count-label">
            images
          </span>
        </div>
      </section>

      <div
        class="gallery-grid"
        id="gallery-grid"
        data-scenario={scenarioSlug}
        data-gallery={gallery.slug}
        data-gallery-title={gallery.title}
      >
        <p class="gallery-loading">
          Loading gallery...
        </p>
      </div>
    </main>

    <div
      class="viewer"
      id="viewer"
      aria-hidden="true"
    >
      <button
        id="close"
        class="close"
        type="button"
        aria-label="Close"
      >
        ×
      </button>

      <button
        id="previous"
        class="arrow previous"
        type="button"
        aria-label="Previous image"
      >
        ‹
      </button>

      <div class="viewer-content">
        <img
          id="viewer-image"
          src=""
          alt=""
        />

        <p id="counter"></p>
      </div>

      <button
        id="next"
        class="arrow next"
        type="button"
        aria-label="Next image"
      >
        ›
      </button>
    </div>

    <script>
      let items = Array.from(
        document.querySelectorAll(".gallery-item")
      );

      const viewer =
        document.getElementById("viewer");

      const viewerImage =
        document.getElementById("viewer-image");

      const counter =
        document.getElementById("counter");

      const close =
        document.getElementById("close");

      const previous =
        document.getElementById("previous");

      const next =
        document.getElementById("next");

      let currentIndex = 0;

      // Zoom / pan state
      let scale = 1;
      let translateX = 0;
      let translateY = 0;

      let startTranslateX = 0;
      let startTranslateY = 0;

      let pointers = new Map();

      let initialPinchDistance = 0;
      let initialPinchScale = 1;

      let swipeStartX = 0;
      let swipeStartY = 0;

      let lastTap = 0;

      const MIN_SCALE = 1;
      const MAX_SCALE = 5;

      function applyTransform() {
        viewerImage.style.transform =
          `translate(${translateX}px, ${translateY}px) scale(${scale})`;
      }

      function resetZoom() {
        scale = 1;
        translateX = 0;
        translateY = 0;

        viewerImage.style.transition = "transform 0.2s ease";

        applyTransform();

        setTimeout(() => {
          viewerImage.style.transition = "";
        }, 200);
      }

      function showImage(index) {
        const item = items[index];

        if (!item) return;

        currentIndex = index;

        viewerImage.src =
          item.dataset.src || "";

        viewerImage.alt =
          item.dataset.alt || "Gallery image";

        counter.textContent =
          `${index + 1} / ${items.length}`;

        resetZoom();
      }

      function openViewer(index) {
        showImage(index);

        viewer.classList.add("open");

        viewer.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.classList.add(
          "viewer-open"
        );
      }

      function closeViewer() {
        viewer.classList.remove("open");

        viewer.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.classList.remove(
          "viewer-open"
        );

        resetZoom();
      }

      function nextImage() {
        if (items.length === 0) return;

        showImage(
          (currentIndex + 1) % items.length
        );
      }

      function previousImage() {
        if (items.length === 0) return;

        showImage(
          (currentIndex - 1 + items.length) %
            items.length
        );
      }

      function getDistance(point1, point2) {
        const x = point2.clientX - point1.clientX;
        const y = point2.clientY - point1.clientY;

        return Math.hypot(x, y);
      }

      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;

          if (!(target instanceof Element)) {
            return;
          }

          const item =
            target.closest(".gallery-item");

          if (!item) {
            return;
          }

          items = Array.from(
            document.querySelectorAll(
              ".gallery-item"
            )
          );

          const index =
            items.indexOf(item);

          if (index === -1) {
            return;
          }

          openViewer(index);
        }
      );

      close?.addEventListener(
        "click",
        closeViewer
      );

      next?.addEventListener(
        "click",
        nextImage
      );

      previous?.addEventListener(
        "click",
        previousImage
      );

      // -------------------------
      // POINTER DOWN
      // -------------------------

      viewerImage?.addEventListener(
        "pointerdown",
        (event) => {
          event.preventDefault();

          viewerImage.setPointerCapture(
            event.pointerId
          );

          pointers.set(
            event.pointerId,
            event
          );

          if (pointers.size === 1) {
            startTranslateX = translateX;
            startTranslateY = translateY;

            swipeStartX = event.clientX;
            swipeStartY = event.clientY;
          }

          if (pointers.size === 2) {
            const points =
              Array.from(pointers.values());

            initialPinchDistance =
              getDistance(
                points[0],
                points[1]
              );

            initialPinchScale = scale;
          }
        }
      );

      // -------------------------
      // POINTER MOVE
      // -------------------------

      viewerImage?.addEventListener(
        "pointermove",
        (event) => {
          if (
            !pointers.has(event.pointerId)
          ) {
            return;
          }

          pointers.set(
            event.pointerId,
            event
          );

          // Pinch zoom
          if (pointers.size === 2) {
            const points =
              Array.from(pointers.values());

            const distance =
              getDistance(
                points[0],
                points[1]
              );

            if (
              initialPinchDistance > 0
            ) {
              scale =
                initialPinchScale *
                (distance /
                  initialPinchDistance);

              scale = Math.min(
                MAX_SCALE,
                Math.max(
                  MIN_SCALE,
                  scale
                )
              );

              if (scale === 1) {
                translateX = 0;
                translateY = 0;
              }

              applyTransform();
            }

            return;
          }

          // Drag image when zoomed
          if (
            pointers.size === 1 &&
            scale > 1
          ) {
            const point =
              Array.from(
                pointers.values()
              )[0];

            translateX =
              startTranslateX +
              (point.clientX -
                swipeStartX);

            translateY =
              startTranslateY +
              (point.clientY -
                swipeStartY);

            applyTransform();
          }
        }
      );

      // -------------------------
      // POINTER UP
      // -------------------------

      function handlePointerEnd(event) {
        const point =
          pointers.get(event.pointerId);

        if (!point) return;

        const endX = event.clientX;
        const endY = event.clientY;

        const differenceX =
          endX - swipeStartX;

        const differenceY =
          endY - swipeStartY;

        pointers.delete(
          event.pointerId
        );

        // Swipe between photos only
        // when image isn't zoomed.
        if (
          pointers.size === 0 &&
          scale === 1
        ) {
          const horizontalSwipe =
            Math.abs(differenceX) > 60;

          const mostlyHorizontal =
            Math.abs(differenceX) >
            Math.abs(differenceY);

          if (
            horizontalSwipe &&
            mostlyHorizontal
          ) {
            if (differenceX < 0) {
              nextImage();
            } else {
              previousImage();
            }
          }
        }

        if (
          pointers.size === 1 &&
          scale > 1
        ) {
          const remaining =
            Array.from(
              pointers.values()
            )[0];

          swipeStartX =
            remaining.clientX;

          swipeStartY =
            remaining.clientY;

          startTranslateX =
            translateX;

          startTranslateY =
            translateY;
        }

        if (scale < 1) {
          resetZoom();
        }
      }

      viewerImage?.addEventListener(
        "pointerup",
        handlePointerEnd
      );

      viewerImage?.addEventListener(
        "pointercancel",
        handlePointerEnd
      );

      // -------------------------
      // DOUBLE TAP / DOUBLE CLICK
      // -------------------------

      viewerImage?.addEventListener(
        "pointerup",
        () => {
          if (pointers.size > 0) {
            return;
          }

          const now = Date.now();

          if (now - lastTap < 300) {
            if (scale > 1) {
              resetZoom();
            } else {
              scale = 2.5;
              translateX = 0;
              translateY = 0;

              viewerImage.style.transition =
                "transform 0.2s ease";

              applyTransform();

              setTimeout(() => {
                viewerImage.style.transition =
                  "";
              }, 200);
            }

            lastTap = 0;
          } else {
            lastTap = now;
          }
        }
      );

      // -------------------------
      // DESKTOP MOUSE WHEEL ZOOM
      // -------------------------

      viewerImage?.addEventListener(
        "wheel",
        (event) => {
          if (!viewer?.classList.contains("open")) {
            return;
          }

          event.preventDefault();

          const zoomAmount =
            event.deltaY < 0
              ? 0.25
              : -0.25;

          scale += zoomAmount;

          scale = Math.min(
            MAX_SCALE,
            Math.max(
              MIN_SCALE,
              scale
            )
          );

          if (scale === 1) {
            translateX = 0;
            translateY = 0;
          }

          applyTransform();
        },
        { passive: false }
      );

      // -------------------------
      // KEYBOARD
      // -------------------------

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            !viewer?.classList.contains(
              "open"
            )
          ) {
            return;
          }

          if (event.key === "Escape") {
            closeViewer();
          }

          if (
            event.key === "ArrowRight" &&
            scale === 1
          ) {
            nextImage();
          }

          if (
            event.key === "ArrowLeft" &&
            scale === 1
          ) {
            previousImage();
          }
        }
      );
    </script>

    <script>
      const galleryGrid =
        document.getElementById("gallery-grid");

      if (galleryGrid) {
        const scenario =
          galleryGrid.dataset.scenario;

        const gallery =
          galleryGrid.dataset.gallery;

        const galleryTitle =
          galleryGrid.dataset.galleryTitle ||
          "Gallery";

        const galleryCount =
          document.getElementById(
            "gallery-count"
          );

        const galleryCountLabel =
          document.getElementById(
            "gallery-count-label"
          );

        async function loadGalleryImages() {
          try {
            const response = await fetch(
              `/api/gallery-images?scenario=${encodeURIComponent(
                scenario
              )}&gallery=${encodeURIComponent(
                gallery
              )}`
            );

            if (!response.ok) {
              throw new Error(
                "Could not load gallery."
              );
            }

            const data =
              await response.json();

            const imageCount =
              data.images?.length || 0;

            if (galleryCount) {
              galleryCount.textContent =
                String(imageCount);
            }

            if (galleryCountLabel) {
              galleryCountLabel.textContent =
                imageCount === 1
                  ? "image"
                  : "images";
            }

            galleryGrid.innerHTML = "";

            if (
              !data.images ||
              data.images.length === 0
            ) {
              galleryGrid.innerHTML = `
                <div class="empty-gallery">
                  <p>No images have been added to this gallery yet.</p>
                </div>
              `;

              return;
            }

            data.images.forEach(
              (image, index) => {
                const button =
                  document.createElement(
                    "button"
                  );

                button.type = "button";

                button.className =
                  "gallery-item";

                button.dataset.index =
                  String(index);

                button.dataset.src =
                  image.url;

                button.dataset.alt =
                  `${galleryTitle} image ${
                    index + 1
                  }`;

                const img =
                  document.createElement(
                    "img"
                  );

                img.src = image.url;

                img.alt =
                  `${galleryTitle} image ${
                    index + 1
                  }`;

                img.loading = "lazy";

                img.decoding = "async";

                button.appendChild(img);

                galleryGrid.appendChild(
                  button
                );
              }
            );

            window.dispatchEvent(
              new CustomEvent(
                "gallery-images-loaded",
                {
                  detail: {
                    images:
                      data.images,
                  },
                }
              )
            );
          } catch (error) {
            console.error(error);

            galleryGrid.innerHTML = `
              <div class="empty-gallery">
                <p>Could not load this gallery.</p>
              </div>
            `;
          }
        }

        loadGalleryImages();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family:
      Inter,
      system-ui,
      sans-serif;

    background: #0b0b0c;
    color: white;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  body.viewer-open {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  .site-header {
    width: min(1400px, calc(100% - 40px));
    min-height: 72px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid #29292c;
  }

  .site-header > a:last-child {
    color: #99999e;
    font-size: 0.9rem;
  }

  .logo {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  main {
    width: min(1400px, calc(100% - 40px));
    margin: 0 auto;
  }

  .breadcrumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;

  padding-top: 30px;

  color: var(--text-muted);
  font-size: 0.78rem;
}

.breadcrumbs a {
  transition:
    color 0.2s ease,
    text-shadow 0.2s ease;
}

.breadcrumbs a:hover {
  color: #d8d0ff;

  text-shadow:
    0 0 10px
    rgba(157, 132, 255, 0.28);
}

  .gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;

    padding: 65px 0 45px;
  }

  .eyebrow {
  margin: 0 0 12px;

  color: #aa9dff;

  font-size: 0.68rem;
  font-weight: 700;

  letter-spacing: 0.16em;

  text-shadow:
    0 0 12px
    rgba(162, 134, 255, 0.25);
  }

  h1 {
  margin: 0;

  font-size:
    clamp(3rem, 7vw, 6rem);

  line-height: 0.95;
  letter-spacing: -0.05em;

  background:
    linear-gradient(
      105deg,
      #ffffff 5%,
      #c8dcff 38%,
      #cbb9ff 68%,
      #ffffff 100%
    );

  background-clip: text;
  -webkit-background-clip: text;

  color: transparent;

  filter:
    drop-shadow(
      0 0 18px
      rgba(137, 134, 255, 0.2)
    );
  }

  .count {
  color: #ddd7ff;

  font-size: 2.4rem;
  font-weight: 700;

  text-align: right;

  text-shadow:
    0 0 14px
    rgba(145, 119, 255, 0.16);
}

.count strong {
  font: inherit;
  font-weight: inherit;
}

.count span {
  display: block;

  margin-top: 6px;

  color: var(--text-muted);

  font-size: 0.65rem;
  font-weight: 600;

  text-transform: uppercase;
  letter-spacing: 0.12em;
}

  /* Phone-style thumbnail gallery */

  .gallery {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 5px;

    padding-bottom: 100px;
  }

  .gallery-item {
  width: 100%;
  aspect-ratio: 1 / 1;

  padding: 0;

  overflow: hidden;

  border:
    1px solid
    rgba(158, 147, 220, 0.08);

  background: #090c18;

  cursor: pointer;
}

  .gallery-item img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .gallery-item:hover img {
  opacity: 0.9;
  transform: scale(1.02);
}

.gallery-item:hover {
  border-color:
    rgba(170, 147, 255, 0.3);
}

  .empty-gallery {
    min-height: 420px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 60px 20px;

    border-top:
      1px solid var(--border-soft);

    text-align: center;
  }

  .empty-content {
    max-width: 420px;
  }

  .mascot-glow {
    position: relative;

    width: 260px;
    height: 260px;

    margin: 0 auto 24px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mascot-glow::before {
    content: "";

    position: absolute;

    width: 190px;
    height: 190px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(149, 119, 255, 0.35),
        rgba(67, 123, 255, 0.14) 45%,
        transparent 72%
      );

    filter: blur(14px);

    animation:
      mascot-pulse 4s ease-in-out infinite;
  }

  .mascot-cat {
    position: relative;
    z-index: 1;

    display: block;

    max-width: 250px;
    max-height: 250px;

    object-fit: contain;

    filter:
      drop-shadow(
        0 0 12px
        rgba(149, 126, 255, 0.28)
      );
  }

  .empty-content h2 {
    margin: 0 0 10px;

    color: var(--text-main);

    font-size: 1.3rem;
  }

  .empty-content p {
    margin: 0;

    color: var(--text-muted);

    font-size: 0.9rem;
    line-height: 1.6;
  }

  @keyframes mascot-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.95);
    }

    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-glow::before {
      animation: none;
    }
  }

  /* Full-screen photo viewer */

  .viewer {
    position: fixed;
    inset: 0;

    z-index: 9999;

    display: none;

    width: 100vw;
    height: 100dvh;

    align-items: center;
    justify-content: center;

    background: #000;
  }

  .viewer.open {
    display: flex;
  }

  .viewer-content {
    width: 100%;
    height: 100%;

    padding: 55px 65px 40px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  #viewer-image {
    display: block;

    max-width: 100%;
    max-height: calc(100vh - 105px);

    width: auto;
    height: auto;

    object-fit: contain;

    transform-origin: center center;

    touch-action: none;

    user-select: none;
    -webkit-user-select: none;

    -webkit-user-drag: none;

    cursor: grab;

    will-change: transform;
  }

  #viewer-image:active {
    cursor: grabbing;
  }

  #counter {
    margin: 12px 0 0;

    color: #888;
    font-size: 0.75rem;
  }

  .close {
    position: fixed;
    top: 14px;
    right: 18px;

    z-index: 10001;

    width: 48px;
    height: 48px;

    border: 0;

    background: transparent;
    color: white;

    font-size: 2rem;

    cursor: pointer;
  }

  .arrow {
    position: fixed;
    top: 50%;

    z-index: 10001;

    width: 55px;
    height: 90px;

    transform: translateY(-50%);

    border: 0;

    background: transparent;
    color: rgba(255,255,255,0.7);

    font-size: 3rem;

    cursor: pointer;
  }

  .arrow:hover {
    color: white;
  }

  .previous {
    left: 5px;
  }

  .next {
    right: 5px;
  }

  @media (max-width: 600px) {
    .site-header,
    main {
      width: calc(100% - 24px);
    }

    .gallery-header {
      display: block;
      padding: 45px 0 35px;
    }

    .count {
      margin-top: 25px;
      text-align: left;
    }

    .gallery {
      grid-template-columns:
        repeat(3, 1fr);

      gap: 3px;
    }

    .viewer-content {
      padding: 50px 10px 35px;
    }

    .arrow {
      width: 38px;
    }
  }
</style>