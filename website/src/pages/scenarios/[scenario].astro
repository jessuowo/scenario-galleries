---
import { scenarios } from "../../data/scenarios.js";
import { site } from "../../data/site.js";
import "../../styles/theme.css";

import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export function getStaticPaths() {
  return scenarios.map((scenario) => ({
    params: {
      scenario: scenario.slug,
    },

    props: {
      scenario,
    },
  }));
}

const { scenario } = Astro.props;

const totalImages = scenario.galleries.reduce(
  (total, gallery) => total + gallery.images.length,
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={scenario.description}
    />

    <title>
      {scenario.title} | Scenario Galleries
    </title>
  </head>

  <body>
    <SiteHeader />

    <main
      id="scenario-page"
      data-scenario={scenario.slug}
    >
      <a href="/" class="back-link">
        ← All Scenarios
      </a>

      <section class="scenario-hero">
        <div class="scenario-cover">
          {
            scenario.cover ? (
              <img
                id="scenario-cover-image"
                src={scenario.cover}
                alt={`${scenario.title} cover`}
              />
            ) : (
              <span>
                Scenario cover coming soon
              </span>
            )
          }
        </div>

        <div class="scenario-info">
          <p class="eyebrow">
            FICTIONLAB SCENARIO
          </p>

          <h1>{scenario.title}</h1>

          <p class="description">
            {scenario.description}
          </p>

          <div class="stats">
            <span>
              {scenario.galleries.length}
              {" "}
              {scenario.galleries.length === 1
                ? "album"
                : "albums"}
            </span>

            <span>•</span>

            <span>
              <span id="scenario-image-count">0</span>
              {" "}
              <span id="scenario-image-label">
                images
              </span>
            </span>
          </div>

          {
            scenario.fictionLabUrl && (
              <a
                class="fictionlab-button"
                href={scenario.fictionLabUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on FictionLab ↗
              </a>
            )
          }
        </div>
      </section>

      <section class="albums-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              BROWSE
            </p>

            <h2>Gallery Albums</h2>
          </div>

          <span>
            {scenario.galleries.length} albums
          </span>
        </div>

        <div class="album-grid">
          {
            scenario.galleries.map((gallery) => {
              return (
                <a
                  href={`/scenarios/${scenario.slug}/${gallery.slug}`}
                  class="album-card"
                  data-gallery={gallery.slug}
                >
                  <div class="album-cover">
                    <span>Loading images...</span>
                  </div>

                  <div class="album-content">
                    <div class="album-labels">
                      <p class="album-type">
                        {gallery.type}
                      </p>

                      <span class:list={[
                        "rating",
                        gallery.rating === "nsfw" && "rating-nsfw"
                      ]}>
                        {gallery.rating === "nsfw" ? "18+" : "SFW"}
                      </span>
                    </div>

                    <h3>
                      {gallery.title}
                    </h3>

                    {
                      gallery.description && (
                        <p class="album-description">
                          {gallery.description}
                        </p>
                      )
                    }

                    <p class="image-count">
                      <span class="album-image-number">0</span>
                      {" "}
                      <span class="album-image-label">
                        images
                      </span>
                    </p>

                    <span class="view-link">
                      View gallery →
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>
    </main>

    <SiteFooter />

    <script>
      const scenarioPage =
        document.getElementById(
          "scenario-page"
        );

      if (scenarioPage) {
        const scenarioSlug =
          scenarioPage.dataset.scenario;

        async function loadScenarioSummary() {
          try {
            const response =
              await fetch(
                `/api/scenario-summary?scenario=${encodeURIComponent(
                  scenarioSlug
                )}`
              );

            if (!response.ok) {
              throw new Error(
                "Could not load scenario summary."
              );
            }

            const data =
              await response.json();

            const scenarioCoverImage =
              document.getElementById(
                "scenario-cover-image"
              );

            if (scenarioCoverImage) {
              if (data.scenarioCover) {
                scenarioCoverImage.src =
                  data.scenarioCover;
              }

              const cropX =
                Number.isFinite(
                  data.scenarioCropX
                )
                  ? data.scenarioCropX
                  : 50;

              const cropY =
                Number.isFinite(
                  data.scenarioCropY
                )
                  ? data.scenarioCropY
                  : 50;

              scenarioCoverImage.style.objectPosition =
                `${cropX}% ${cropY}%`;
            }

            // Update total scenario image count
            const totalCount =
              document.getElementById(
                "scenario-image-count"
              );

            const totalLabel =
              document.getElementById(
                "scenario-image-label"
              );

            if (totalCount) {
              totalCount.textContent =
                String(data.totalImages || 0);
            }

            if (totalLabel) {
              totalLabel.textContent =
                data.totalImages === 1
                  ? "image"
                  : "images";
            }

            // Update each album card
            document
              .querySelectorAll(
                ".album-card[data-gallery]"
              )
              .forEach((card) => {
                const gallerySlug =
                  card.dataset.gallery;

                const galleryData =
                  data.galleries?.[
                    gallerySlug
                  ];

                const count =
                  galleryData?.count || 0;

                const countElement =
                  card.querySelector(
                    ".album-image-number"
                  );

                const labelElement =
                  card.querySelector(
                    ".album-image-label"
                  );

                if (countElement) {
                  countElement.textContent =
                    String(count);
                }

                if (labelElement) {
                  labelElement.textContent =
                    count === 1
                      ? "image"
                      : "images";
                }

                const cover =
                  card.querySelector(
                    ".album-cover"
                  );

                if (!cover) {
                  return;
                }

                cover.innerHTML = "";

                if (galleryData?.cover) {
                  const img =
                    document.createElement(
                      "img"
                    );

                  img.src =
                    galleryData.cover;

                  img.alt =
                    card.querySelector("h3")
                      ?.textContent ||
                    "Gallery cover";

                  img.loading = "lazy";

                  cover.appendChild(img);
                } else {
                  const empty =
                    document.createElement(
                      "span"
                    );

                  empty.textContent =
                    "No images yet";

                  cover.appendChild(empty);
                }
              });
          } catch (error) {
            console.error(error);
          }
        }

        loadScenarioSummary();
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #0b0b0c;
    color: #f5f5f5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding-top: 42px;
  }

  .back-link {
    display: inline-block;

    margin-bottom: 34px;

    color: #909095;

    font-size: 0.9rem;
  }

  .back-link:hover {
    color: white;
  }

  .scenario-hero {
    display: grid;

    grid-template-columns:
      minmax(280px, 480px) 1fr;

    gap: 64px;

    align-items: center;

    padding-bottom: 90px;
  }

  .scenario-cover {
    position: relative;

    aspect-ratio: 4 / 3;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border:
      1px solid
      var(--border-soft);

    border-radius: 20px;

    background:
      linear-gradient(
        145deg,
        rgba(17, 37, 82, 0.88),
        rgba(8, 14, 38, 0.92)
      );

    color: var(--text-muted);

    font-size: 0.85rem;

    box-shadow:
      0 24px 70px
      rgba(1, 4, 25, 0.42),
      0 0 40px
      rgba(111, 88, 255, 0.10);
  }

  .scenario-cover::after {
    content: "";

    position: absolute;
    inset: 0;

    pointer-events: none;

    border-radius: inherit;

    box-shadow:
      inset 0 0 35px
      rgba(149, 125, 255, 0.08);
  }

  .scenario-cover img {
    position: relative;
    z-index: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .scenario-info {
    max-width: 630px;
  }

  .eyebrow {
  margin: 0 0 14px;

  color: #a99cff;

  font-size: 0.7rem;
  font-weight: 750;

  letter-spacing: 0.18em;

  text-shadow:
    0 0 12px
    rgba(162, 134, 255, 0.25);
  }

  h1 {
    margin: 0;

    font-size:
      clamp(2.7rem, 6vw, 5.2rem);

    line-height: 0.98;
    letter-spacing: -0.05em;

    background:
      linear-gradient(
        105deg,
        #ffffff 5%,
        #c8dcff 38%,
        #cbb9ff 68%,
        #ffffff 100%
      );

    background-clip: text;
    -webkit-background-clip: text;

    color: transparent;

    filter:
      drop-shadow(
        0 0 18px
        rgba(137, 134, 255, 0.2)
      );
  }

  .description {
    max-width: 570px;

    margin: 28px 0 22px;

   color: var(--text-soft);

    font-size: 1rem;
    line-height: 1.7;
  }

  .stats {
    display: flex;
    gap: 10px;

    color: var(--text-muted);

    font-size: 0.84rem;
  }

  .fictionlab-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  margin-top: 28px;
  padding: 12px 18px;

  border:
    1px solid
    rgba(173, 149, 255, 0.45);

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      rgba(72, 97, 210, 0.82),
      rgba(104, 63, 181, 0.82)
    );

  color: white;

  font-size: 0.85rem;
  font-weight: 700;

  box-shadow:
    0 0 22px
    rgba(117, 91, 255, 0.13);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.fictionlab-button:hover {
  transform: translateY(-2px);

  border-color:
    rgba(202, 188, 255, 0.7);

  box-shadow:
    0 0 30px
    rgba(132, 102, 255, 0.25);
  }

  .albums-section {
    padding-bottom: 110px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;

    padding-bottom: 18px;
    margin-bottom: 28px;

    border-bottom:
      1px solid #252527;
  }

  .section-heading h2 {
    margin: 0;

    font-size: 1.55rem;
  }

  .section-heading > span {
    color: #747479;

    font-size: 0.85rem;
  }

  .album-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .album-card {
    overflow: hidden;

    border:
      1px solid
      var(--border-soft);

    border-radius: 18px;

    background:
      linear-gradient(
        145deg,
        rgba(16, 31, 70, 0.82),
        rgba(8, 14, 38, 0.88)
      );

    backdrop-filter: blur(14px);

    box-shadow:
      0 18px 45px
      rgba(0, 0, 20, 0.22);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .album-card:hover {
    transform: translateY(-5px);

    border-color:
      var(--border-glow);

    box-shadow:
      0 24px 60px
      rgba(18, 30, 100, 0.28),
      0 0 32px
      rgba(145, 111, 255, 0.13);
  }

  .album-cover {
    aspect-ratio: 4 / 5;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #171719;

    border-bottom:
      1px solid #28282b;

    color: #626267;

    font-size: 0.8rem;
  }

  .album-cover img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

    transition:
      transform 0.35s ease,
      filter 0.35s ease;
  }

  .album-card:hover .album-cover img {
    transform: scale(1.025);

    filter:
      brightness(1.04)
      saturate(1.05);
  }

  .album-content {
    padding: 20px;
  }

  .album-labels {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    margin-bottom: 9px;
  }

  .album-type {
    margin: 0;

    color: #727277;

    font-size: 0.68rem;
    font-weight: 750;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .rating {
    flex-shrink: 0;

    padding: 4px 7px;

    border: 1px solid #343438;
    border-radius: 5px;

    color: #85858a;

    font-size: 0.58rem;
    font-weight: 750;

    letter-spacing: 0.08em;
  }

  .rating-nsfw {
    color: #d5d5d8;
    border-color: #55555a;
  }

  .album-content h3 {
    .album-description {
  margin: 10px 0 0;

  color: #85858a;

  font-size: 0.82rem;
  line-height: 1.5;
}
    margin: 0;

    font-size: 1.15rem;
  }

  .image-count {
    margin: 14px 0 20px;

    color: #77777c;

    font-size: 0.82rem;
  }

  .view-link {
  color: #c9bcff;

  font-size: 0.87rem;
  font-weight: 650;

  text-shadow:
    0 0 10px
    rgba(161, 132, 255, 0.22);
  }

  @media (max-width: 850px) {
    .scenario-hero {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .scenario-cover {
      max-width: 550px;
    }

    .album-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    main {
      width: calc(100% - 28px);
      padding-top: 28px;
    }

    .scenario-hero {
      padding-bottom: 65px;
    }

    .album-grid {
      grid-template-columns: 1fr;
    }
  }
</style>