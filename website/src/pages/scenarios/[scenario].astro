---
import { scenarios } from "../../data/scenarios.js";

export function getStaticPaths() {
  return scenarios.map((scenario) => ({
    params: {
      scenario: scenario.slug,
    },

    props: {
      scenario,
    },
  }));
}

const { scenario } = Astro.props;

const totalImages = scenario.galleries.reduce(
  (total, gallery) => total + gallery.images.length,
  0
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={scenario.description}
    />

    <title>
      {scenario.title} | Scenario Galleries
    </title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">
        SCENARIO GALLERIES
      </a>

      <nav>
        <a href="/">
          Scenarios
        </a>
      </nav>
    </header>

    <main>
      <a href="/" class="back-link">
        ← All Scenarios
      </a>

      <section class="scenario-hero">
        <div class="scenario-cover">
          {
            scenario.cover ? (
              <img
                src={scenario.cover}
                alt={`${scenario.title} cover`}
              />
            ) : (
              <span>
                Scenario cover coming soon
              </span>
            )
          }
        </div>

        <div class="scenario-info">
          <p class="eyebrow">
            FICTIONLAB SCENARIO
          </p>

          <h1>{scenario.title}</h1>

          <p class="description">
            {scenario.description}
          </p>

          <div class="stats">
            <span>
              {scenario.galleries.length}
              {" "}
              {scenario.galleries.length === 1
                ? "album"
                : "albums"}
            </span>

            <span>•</span>

            <span>
              {totalImages}
              {" "}
              {totalImages === 1
                ? "image"
                : "images"}
            </span>
          </div>

          {
            scenario.fictionLabUrl && (
              <a
                class="fictionlab-button"
                href={scenario.fictionLabUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on FictionLab ↗
              </a>
            )
          }
        </div>
      </section>

      <section class="albums-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              BROWSE
            </p>

            <h2>Gallery Albums</h2>
          </div>

          <span>
            {scenario.galleries.length} albums
          </span>
        </div>

        <div class="album-grid">
          {
            scenario.galleries.map((gallery) => {
              const cover = gallery.cover
                ? {
                    src: gallery.cover,
                    alt: gallery.title,
                  }
                : gallery.images.length > 0
                  ? gallery.images[0]
                  : null;

              return (
                <a
                  href={`/scenarios/${scenario.slug}/${gallery.slug}`}
                  class="album-card"
                >
                  <div class="album-cover">
                    {
                      cover ? (
                        <img
                          src={cover.src}
                          alt={gallery.title}
                          loading="lazy"
                        />
                      ) : (
                        <span>
                          No images yet
                        </span>
                      )
                    }
                  </div>

                  <div class="album-content">
                    <div class="album-labels">
                      <p class="album-type">
                        {gallery.type}
                      </p>

                      <span class:list={[
                        "rating",
                        gallery.rating === "nsfw" && "rating-nsfw"
                      ]}>
                        {gallery.rating === "nsfw" ? "18+" : "SFW"}
                      </span>
                    </div>

                    <h3>
                      {gallery.title}
                    </h3>

                    {
                      gallery.description && (
                        <p class="album-description">
                          {gallery.description}
                        </p>
                      )
                    }

                    <p class="image-count">
                      {gallery.images.length}
                      {" "}
                      {gallery.images.length === 1
                        ? "image"
                        : "images"}
                    </p>

                    <span class="view-link">
                      View gallery →
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>
    </main>

    <footer>
      <p>Scenario Galleries</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #0b0b0c;
    color: #f5f5f5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 70% 0%,
        rgba(255,255,255,0.06),
        transparent 35rem
      ),
      #0b0b0c;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    min-height: 76px;

    margin: 0 auto;

    display: flex;
    justify-content: space-between;
    align-items: center;

    border-bottom:
      1px solid #252527;
  }

  .logo {
    font-size: 0.83rem;
    font-weight: 800;

    letter-spacing: 0.16em;
  }

  nav a {
    color: #9a9a9f;
    font-size: 0.9rem;
  }

  main {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding-top: 42px;
  }

  .back-link {
    display: inline-block;

    margin-bottom: 34px;

    color: #909095;

    font-size: 0.9rem;
  }

  .back-link:hover {
    color: white;
  }

  .scenario-hero {
    display: grid;

    grid-template-columns:
      minmax(280px, 480px) 1fr;

    gap: 64px;

    align-items: center;

    padding-bottom: 90px;
  }

  .scenario-cover {
    aspect-ratio: 4 / 3;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border:
      1px solid #29292c;

    border-radius: 18px;

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,0.05),
        rgba(255,255,255,0.01)
      ),
      #151517;

    color: #66666b;

    font-size: 0.85rem;
  }

  .scenario-cover img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .scenario-info {
    max-width: 630px;
  }

  .eyebrow {
    margin: 0 0 14px;

    color: #7c7c81;

    font-size: 0.7rem;
    font-weight: 750;

    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;

    font-size:
      clamp(2.7rem, 6vw, 5.2rem);

    line-height: 0.98;

    letter-spacing: -0.05em;
  }

  .description {
    max-width: 570px;

    margin: 28px 0 22px;

    color: #a0a0a5;

    font-size: 1rem;
    line-height: 1.7;
  }

  .stats {
    display: flex;
    gap: 10px;

    color: #707075;

    font-size: 0.84rem;
  }

  .fictionlab-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 28px;
    padding: 12px 18px;

    border: 1px solid #3a3a3f;
    border-radius: 8px;

    background: #f1f1f1;
    color: #111113;

    font-size: 0.85rem;
    font-weight: 700;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .fictionlab-button:hover {
    transform: translateY(-2px);
    background: white;
  }

  .albums-section {
    padding-bottom: 110px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;

    padding-bottom: 18px;
    margin-bottom: 28px;

    border-bottom:
      1px solid #252527;
  }

  .section-heading h2 {
    margin: 0;

    font-size: 1.55rem;
  }

  .section-heading > span {
    color: #747479;

    font-size: 0.85rem;
  }

  .album-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .album-card {
    overflow: hidden;

    border:
      1px solid #28282b;

    border-radius: 16px;

    background: #111113;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .album-card:hover {
    transform:
      translateY(-4px);

    border-color: #55555b;
  }

  .album-cover {
    aspect-ratio: 4 / 5;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #171719;

    border-bottom:
      1px solid #28282b;

    color: #626267;

    font-size: 0.8rem;
  }

  .album-cover img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;
  }

  .album-content {
    padding: 20px;
  }

  .album-labels {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    margin-bottom: 9px;
  }

  .album-type {
    margin: 0;

    color: #727277;

    font-size: 0.68rem;
    font-weight: 750;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .rating {
    flex-shrink: 0;

    padding: 4px 7px;

    border: 1px solid #343438;
    border-radius: 5px;

    color: #85858a;

    font-size: 0.58rem;
    font-weight: 750;

    letter-spacing: 0.08em;
  }

  .rating-nsfw {
    color: #d5d5d8;
    border-color: #55555a;
  }

  .album-content h3 {
    .album-description {
  margin: 10px 0 0;

  color: #85858a;

  font-size: 0.82rem;
  line-height: 1.5;
}
    margin: 0;

    font-size: 1.15rem;
  }

  .image-count {
    margin: 14px 0 20px;

    color: #77777c;

    font-size: 0.82rem;
  }

  .view-link {
    font-size: 0.87rem;
    font-weight: 650;
  }

  footer {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 28px 0 50px;

    border-top:
      1px solid #252527;

    color: #68686d;

    font-size: 0.8rem;
  }

  @media (max-width: 850px) {
    .scenario-hero {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .scenario-cover {
      max-width: 550px;
    }

    .album-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .site-header,
    main,
    footer {
      width: calc(100% - 28px);
    }

    .site-header {
      min-height: 66px;
    }

    main {
      padding-top: 28px;
    }

    .scenario-hero {
      padding-bottom: 65px;
    }

    .album-grid {
      grid-template-columns: 1fr;
    }
  }
</style>