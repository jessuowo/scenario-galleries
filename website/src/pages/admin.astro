---
import { scenarios } from "../data/scenarios.js";
import "../styles/theme.css";

const adminScenarios = scenarios.map((scenario) => ({
  title: scenario.title,
  slug: scenario.slug,
  galleries: scenario.galleries.map((gallery) => ({
    title: gallery.title,
    slug: gallery.slug,
  })),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>Gallery Admin</title>
  </head>

  <body>
    <main class="admin-page">
      <a href="/" class="back-link">
        ← Back to site
      </a>

      <section class="admin-header">
        <p class="eyebrow">
          PRIVATE GALLERY MANAGEMENT
        </p>

        <h1>Gallery Admin</h1>

        <p>
          Upload and remove images from your scenario galleries.
        </p>
      </section>

      <section
        class="login-panel"
        id="login-panel"
      >
        <h2>Admin Access</h2>

        <p>
          Enter your admin token to manage gallery images.
        </p>

        <div class="token-row">
          <input
            id="admin-token"
            type="password"
            placeholder="Admin token"
            autocomplete="off"
          />

          <button
            id="login-button"
            type="button"
          >
            Unlock
          </button>
        </div>

        <p
          class="status"
          id="login-status"
        ></p>
      </section>

      <section
        class="admin-tools"
        id="admin-tools"
        hidden
      >
        <div class="admin-toolbar">
          <span>Admin unlocked</span>

          <button
            id="logout-button"
            class="logout-button"
            type="button"
          >
            Logout
          </button>
        </div>

        <section class="scenario-cover-card">
          <div>
            <p class="eyebrow">
              SCENARIO COVER
            </p>

            <h2>Scenario Cover Image</h2>

            <p class="scenario-cover-description">
              Choose a dedicated cover image or use an image from one of the scenario's albums.
            </p>
          </div>

          <div
            class="scenario-cover-preview"
            id="scenario-cover-preview"
          >
            <span>No scenario cover</span>
          </div>

          <div class="crop-controls">
            <div class="crop-field">
              <div class="crop-label">
                <label for="scenario-crop-x">
                  Horizontal Position
                </label>

                <span id="scenario-crop-x-value">
                  50%
                </span>
              </div>

              <input
                id="scenario-crop-x"
                type="range"
                min="0"
                max="100"
                step="1"
                value="50"
              />
            </div>

            <div class="crop-field">
              <div class="crop-label">
                <label for="scenario-crop-y">
                  Vertical Position
                </label>

                <span id="scenario-crop-y-value">
                  50%
                </span>
              </div>

              <input
                id="scenario-crop-y"
                type="range"
                min="0"
                max="100"
                step="1"
                value="50"
              />
            </div>

            <button
              id="save-scenario-crop"
              class="secondary-button"
              type="button"
            >
              Save Crop Position
            </button>
          </div>

          <div class="scenario-cover-upload">
            <label
              class="secondary-button scenario-cover-picker"
              for="scenario-cover-file"
            >
              Choose Custom Cover
            </label>

            <input
              id="scenario-cover-file"
              type="file"
              accept="image/*"
              hidden
            />

            <button
              id="upload-scenario-cover"
              class="primary-button"
              type="button"
              disabled
            >
              Upload Cover
            </button>
          </div>

          <p
            class="status"
            id="scenario-cover-status"
          ></p>
        </section>

        <div class="controls-card">
          <div class="field">
            <label for="scenario-select">
              Scenario
            </label>

            <select id="scenario-select">
              {
                adminScenarios.map(
                  (scenario) => (
                    <option
                      value={scenario.slug}
                    >
                      {scenario.title}
                    </option>
                  )
                )
              }
            </select>
          </div>

          <div class="field">
            <label for="gallery-select">
              Gallery
            </label>

            <select id="gallery-select"></select>
          </div>
        </div>

        <section class="upload-card">
          <div>
            <p class="eyebrow">
              UPLOAD
            </p>

            <h2>Add Images</h2>
          </div>

          <label
            class="upload-area"
            id="upload-area"
            for="image-files"
          >
            <strong>
              Choose or drop images
            </strong>

            <span>
              Drag images here, or click to browse
            </span>

            <input
              id="image-files"
              type="file"
              accept="image/*"
              multiple
            />
          </label>

          <div
            class="selected-files"
            id="selected-files"
          ></div>

          <button
            id="upload-button"
            class="primary-button"
            type="button"
            disabled
          >
            Upload Images
          </button>

          <p
            class="status"
            id="upload-status"
          ></p>
        </section>

        <section class="existing-card">
          <div class="existing-heading">
            <div>
              <p class="eyebrow">
                CURRENT ALBUM
              </p>

              <h2>Existing Images</h2>
            </div>

            <div class="existing-actions">
              <button
                id="save-order-button"
                class="primary-button save-order-button"
                type="button"
                disabled
              >
                Save Order
              </button>

              <button
                id="refresh-button"
                class="secondary-button"
                type="button"
              >
                Refresh
              </button>
            </div>
          </div>

          <div
            class="image-list"
            id="image-list"
          ></div>

          <p
            class="status"
            id="list-status"
          ></p>
        </section>
      </section>
    </main>

    <script define:vars={{ adminScenarios }}>
      const tokenInput =
        document.getElementById("admin-token");

      const loginButton =
        document.getElementById("login-button");

      const loginStatus =
        document.getElementById("login-status");

      const loginPanel =
        document.getElementById("login-panel");

      const adminTools =
        document.getElementById("admin-tools");

      const logoutButton =
        document.getElementById(
          "logout-button"
        );

      const scenarioSelect =
        document.getElementById("scenario-select");

      const gallerySelect =
        document.getElementById("gallery-select");

      const scenarioCoverPreview =
        document.getElementById(
          "scenario-cover-preview"
        );

      const scenarioCoverFile =
        document.getElementById(
          "scenario-cover-file"
        );

      const uploadScenarioCover =
        document.getElementById(
          "upload-scenario-cover"
        );

      const scenarioCoverStatus =
        document.getElementById(
          "scenario-cover-status"
        );

      const scenarioCropX =
        document.getElementById(
          "scenario-crop-x"
        );

      const scenarioCropY =
        document.getElementById(
          "scenario-crop-y"
        );

      const scenarioCropXValue =
        document.getElementById(
          "scenario-crop-x-value"
        );

      const scenarioCropYValue =
        document.getElementById(
          "scenario-crop-y-value"
        );

      const saveScenarioCrop =
        document.getElementById(
          "save-scenario-crop"
        );

      const saveOrderButton =
        document.getElementById(
          "save-order-button"
        );

      const fileInput =
        document.getElementById("image-files");

      const uploadArea =
        document.getElementById("upload-area");

      const selectedFiles =
        document.getElementById("selected-files");

      const uploadButton =
        document.getElementById("upload-button");

      const uploadStatus =
        document.getElementById("upload-status");

      const imageList =
        document.getElementById("image-list");

      const listStatus =
        document.getElementById("list-status");

      const refreshButton =
        document.getElementById("refresh-button");

      let adminToken =
        sessionStorage.getItem(
          "scenarioGalleryAdminToken"
        ) || "";

      function getSelectedScenario() {
        return adminScenarios.find(
          (scenario) =>
            scenario.slug ===
            scenarioSelect.value
        );
      }

      function populateGalleries() {
        const scenario =
          getSelectedScenario();

        gallerySelect.innerHTML = "";

        if (!scenario) {
          return;
        }

        scenario.galleries.forEach(
          (gallery) => {
            const option =
              document.createElement(
                "option"
              );

            option.value =
              gallery.slug;

            option.textContent =
              gallery.title;

            gallerySelect.appendChild(
              option
            );
          }
        );
      }

      async function verifyToken(token) {
        const response =
          await fetch(
            "/api/admin-test",
            {
              headers: {
                Authorization:
                  `Bearer ${token}`,
              },
            }
          );

        return response.ok;
      }

      async function unlockAdmin(
        token
      ) {
        loginStatus.textContent =
          "Checking access...";

        try {
          const valid =
            await verifyToken(token);

          if (!valid) {
            loginStatus.textContent =
              "Incorrect admin token.";

            return;
          }

          adminToken = token;

          sessionStorage.setItem(
            "scenarioGalleryAdminToken",
            token
          );

          loginPanel.hidden = true;
          adminTools.hidden = false;

          populateGalleries();

          await loadImages();
        } catch {
          loginStatus.textContent =
            "Could not verify admin access.";
        }
      }

      async function loadImages() {
        if (!adminToken) {
          return;
        }

        const scenario =
          scenarioSelect.value;

        const gallery =
          gallerySelect.value;

        listStatus.textContent =
          "Loading images...";

        imageList.innerHTML = "";

        saveOrderButton.disabled =
          true;

        try {
          const response =
            await fetch(
              `/api/admin/images?scenario=${encodeURIComponent(
                scenario
              )}&gallery=${encodeURIComponent(
                gallery
              )}`,
              {
                headers: {
                  Authorization:
                    `Bearer ${adminToken}`,
                },
              }
            );

          if (!response.ok) {
            throw new Error(
              "Could not load images."
            );
          }

          const data =
            await response.json();

          const currentCover =
            data.cover || null;

          const currentScenarioCover =
            data.scenarioCover || null;

          const currentScenarioCoverUrl =
            data.scenarioCoverUrl || null;

          const currentCropX =
            Number.isFinite(
              data.scenarioCropX
            )
              ? data.scenarioCropX
              : 50;

          const currentCropY =
            Number.isFinite(
              data.scenarioCropY
            )
              ? data.scenarioCropY
              : 50;

          scenarioCropX.value =
            String(currentCropX);

          scenarioCropY.value =
            String(currentCropY);

          scenarioCropXValue.textContent =
            `${currentCropX}%`;

          scenarioCropYValue.textContent =
            `${currentCropY}%`;

          scenarioCoverPreview.innerHTML = "";

          if (currentScenarioCoverUrl) {
            const coverImage =
              document.createElement(
                "img"
              );

            coverImage.src =
              currentScenarioCoverUrl;

            coverImage.alt =
              "Current scenario cover";

            coverImage.style.objectPosition =
              `${currentCropX}% ${currentCropY}%`;

            scenarioCoverPreview.appendChild(
              coverImage
            );
          } else {
            const empty =
              document.createElement(
                "span"
              );

            empty.textContent =
              "No scenario cover";

            scenarioCoverPreview.appendChild(
              empty
            );
          }

          if (
            !data.images ||
            data.images.length === 0
          ) {
            listStatus.textContent =
              "No R2 images in this gallery yet.";

            return;
          }

          listStatus.textContent =
            `${data.images.length} ${
              data.images.length === 1
                ? "image"
                : "images"
            }`;

          data.images.forEach(
            (image) => {
              const row =
                document.createElement(
                  "div"
                );

              row.className =
                "image-row";

              row.draggable = true;

              row.dataset.key =
                image.key;

              const reorderControls =
                document.createElement(
                  "div"
                );

              reorderControls.className =
                "reorder-controls";

              const dragHandle =
                document.createElement(
                  "span"
                );

              dragHandle.className =
                "drag-handle";

              dragHandle.textContent =
                "⋮⋮";

              dragHandle.title =
                "Drag to reorder";

              const moveUp =
                document.createElement(
                  "button"
                );

              moveUp.type = "button";
              moveUp.className =
                "order-button";
              moveUp.textContent = "↑";
              moveUp.title = "Move up";

              const moveDown =
                document.createElement(
                  "button"
                );

              moveDown.type = "button";
              moveDown.className =
                "order-button";
              moveDown.textContent = "↓";
              moveDown.title = "Move down";

              reorderControls.append(
                dragHandle,
                moveUp,
                moveDown
              );

              function markOrderChanged() {
                saveOrderButton.disabled =
                  false;

                listStatus.textContent =
                  "Order changed — remember to save.";
              }

              moveUp.addEventListener(
                "click",
                () => {
                  const previous =
                    row.previousElementSibling;

                  if (!previous) {
                    return;
                  }

                  imageList.insertBefore(
                    row,
                    previous
                  );

                  markOrderChanged();
                }
              );

              moveDown.addEventListener(
                "click",
                () => {
                  const next =
                    row.nextElementSibling;

                  if (!next) {
                    return;
                  }

                  imageList.insertBefore(
                    next,
                    row
                  );

                  markOrderChanged();
                }
              );

              row.addEventListener(
                "dragstart",
                (event) => {
                  row.classList.add(
                    "dragging-row"
                  );

                  event.dataTransfer.effectAllowed =
                    "move";

                  event.dataTransfer.setData(
                    "text/plain",
                    image.key
                  );
                }
              );

              row.addEventListener(
                "dragend",
                () => {
                  row.classList.remove(
                    "dragging-row"
                  );

                  markOrderChanged();
                }
              );

              row.addEventListener(
                "dragover",
                (event) => {
                  event.preventDefault();

                  const dragging =
                    imageList.querySelector(
                      ".dragging-row"
                    );

                  if (
                    !dragging ||
                    dragging === row
                  ) {
                    return;
                  }

                  const rect =
                    row.getBoundingClientRect();

                  const after =
                    event.clientY >
                    rect.top +
                      rect.height / 2;

                  if (after) {
                    row.after(dragging);
                  } else {
                    row.before(dragging);
                  }
                }
              );

              const imageMain =
                document.createElement(
                  "div"
                );

              imageMain.className =
                "image-main";

              const thumbnail =
                document.createElement(
                  "img"
                );

              thumbnail.className =
                "image-thumb";

              thumbnail.src =
                `/api/gallery-image?key=${encodeURIComponent(
                  image.key
                )}`;

              thumbnail.alt =
                image.originalName;

              thumbnail.loading =
                "lazy";

              const info =
                document.createElement(
                  "div"
                );

              info.className =
                "image-info";

              const name =
                document.createElement(
                  "strong"
                );

              name.textContent =
                image.originalName;

              const size =
                document.createElement(
                  "span"
                );

              size.textContent =
                formatBytes(image.size);

              info.append(
                name,
                size
              );

              imageMain.append(
                thumbnail,
                info
              );

              const coverButton =
                document.createElement(
                  "button"
                );

              coverButton.type =
                "button";

              coverButton.className =
                "cover-button";

              const isCover =
                currentCover === image.key;

              if (isCover) {
                coverButton.textContent =
                  "★ Album Cover";

                coverButton.disabled =
                  true;

                row.classList.add(
                  "is-cover"
                );
              } else {
                coverButton.textContent =
                  "Set Album Cover";
              }

              coverButton.addEventListener(
                "click",
                async () => {
                  coverButton.disabled =
                    true;

                  coverButton.textContent =
                    "Saving...";

                  try {
                    const response =
                      await fetch(
                        "/api/admin/cover",
                        {
                          method: "POST",

                          headers: {
                            Authorization:
                              `Bearer ${adminToken}`,

                            "Content-Type":
                              "application/json",
                          },

                          body:
                            JSON.stringify({
                              scenario:
                                scenarioSelect.value,

                              gallery:
                                gallerySelect.value,

                              key:
                                image.key,
                            }),
                        }
                      );

                    if (!response.ok) {
                      throw new Error(
                        "Could not set cover."
                      );
                    }

                    listStatus.textContent =
                      "Gallery cover updated.";

                    await loadImages();
                  } catch {
                    coverButton.disabled =
                      false;

                    coverButton.textContent =
                      "Set Album Cover";

                    listStatus.textContent =
                      "Could not update gallery cover.";
                  }
                }
              );

              const scenarioCoverButton =
                document.createElement(
                  "button"
                );

              scenarioCoverButton.type =
                "button";

              scenarioCoverButton.className =
                "scenario-cover-button";

              const isScenarioCover =
                currentScenarioCover ===
                image.key;

              if (isScenarioCover) {
                scenarioCoverButton.textContent =
                  "★ Scenario Cover";

                scenarioCoverButton.disabled =
                  true;
              } else {
                scenarioCoverButton.textContent =
                  "Use as Scenario Cover";
              }

              scenarioCoverButton.addEventListener(
                "click",
                async () => {
                  scenarioCoverButton.disabled =
                    true;

                  scenarioCoverButton.textContent =
                    "Saving...";

                  try {
                    const response =
                      await fetch(
                        "/api/admin/scenario-cover",
                        {
                          method: "POST",

                          headers: {
                            Authorization:
                              `Bearer ${adminToken}`,

                            "Content-Type":
                              "application/json",
                          },

                          body:
                            JSON.stringify({
                              scenario:
                                scenarioSelect.value,

                              key:
                                image.key,
                            }),
                        }
                      );

                    if (!response.ok) {
                      throw new Error(
                        "Could not update scenario cover."
                      );
                    }

                    scenarioCoverStatus.textContent =
                      "Scenario cover updated.";

                    await loadImages();
                  } catch {
                    scenarioCoverButton.disabled =
                      false;

                    scenarioCoverButton.textContent =
                      "Use as Scenario Cover";

                    scenarioCoverStatus.textContent =
                      "Could not update scenario cover.";
                  }
                }
              );

              const deleteButton =
                document.createElement(
                  "button"
                );

              deleteButton.type =
                "button";

              deleteButton.className =
                "delete-button";

              deleteButton.textContent =
                "Delete";

              deleteButton.addEventListener(
                "click",
                async () => {
                  const confirmed =
                    window.confirm(
                      `Delete ${image.originalName}?`
                    );

                  if (!confirmed) {
                    return;
                  }

                  deleteButton.disabled =
                    true;

                  deleteButton.textContent =
                    "Deleting...";

                  try {
                    const response =
                      await fetch(
                        "/api/admin/delete",
                        {
                          method:
                            "DELETE",

                          headers: {
                            Authorization:
                              `Bearer ${adminToken}`,

                            "Content-Type":
                              "application/json",
                          },

                          body:
                            JSON.stringify({
                              key: image.key,
                            }),
                        }
                      );

                    if (!response.ok) {
                      throw new Error(
                        "Delete failed."
                      );
                    }

                    await loadImages();
                  } catch {
                    deleteButton.disabled =
                      false;

                    deleteButton.textContent =
                      "Delete";

                    window.alert(
                      "Could not delete this image."
                    );
                  }
                }
              );

              const imageActions =
                document.createElement(
                  "div"
                );

              imageActions.className =
                "image-actions";

              imageActions.append(
                coverButton,
                scenarioCoverButton,
                deleteButton
              );

              row.append(
                reorderControls,
                imageMain,
                imageActions
              );

              imageList.appendChild(
                row
              );
            }
          );
        } catch {
          listStatus.textContent =
            "Could not load images.";
        }
      }

      async function uploadFiles() {
        const files =
          Array.from(
            fileInput.files || []
          );

        if (
          files.length === 0 ||
          !adminToken
        ) {
          return;
        }

        uploadButton.disabled =
          true;

        let completed = 0;

        for (const file of files) {
          uploadStatus.textContent =
            `Uploading ${
              completed + 1
            } of ${files.length}...`;

          const formData =
            new FormData();

          formData.append(
            "scenario",
            scenarioSelect.value
          );

          formData.append(
            "gallery",
            gallerySelect.value
          );

          formData.append(
            "file",
            file
          );

          try {
            const response =
              await fetch(
                "/api/admin/upload",
                {
                  method: "POST",

                  headers: {
                    Authorization:
                      `Bearer ${adminToken}`,
                  },

                  body: formData,
                }
              );

            if (!response.ok) {
              const data =
                await response.json();

              throw new Error(
                data.message ||
                  "Upload failed."
              );
            }

            completed++;
          } catch (error) {
            uploadStatus.textContent =
              `Upload stopped: ${error.message}`;

            uploadButton.disabled =
              false;

            return;
          }
        }

        uploadStatus.textContent =
          `${completed} ${
            completed === 1
              ? "image"
              : "images"
          } uploaded successfully.`;

        fileInput.value = "";

        selectedFiles.innerHTML = "";

        uploadButton.disabled =
          true;

        await loadImages();
      }

      function formatBytes(bytes) {
        if (!bytes) {
          return "0 KB";
        }

        const mb =
          bytes / 1024 / 1024;

        if (mb >= 1) {
          return `${mb.toFixed(
            2
          )} MB`;
        }

        return `${(
          bytes / 1024
        ).toFixed(1)} KB`;
      }

      loginButton.addEventListener(
        "click",
        () => {
          unlockAdmin(
            tokenInput.value
          );
        }
      );

      tokenInput.addEventListener(
        "keydown",
        (event) => {
          if (
            event.key === "Enter"
          ) {
            unlockAdmin(
              tokenInput.value
            );
          }
        }
      );

      scenarioSelect.addEventListener(
        "change",
        async () => {
          populateGalleries();

          await loadImages();
        }
      );

      gallerySelect.addEventListener(
        "change",
        loadImages
      );

      refreshButton.addEventListener(
        "click",
        loadImages
      );

      scenarioCoverFile?.addEventListener(
        "change",
        () => {
          const file =
            scenarioCoverFile.files?.[0];

          uploadScenarioCover.disabled =
            !file;

          if (file) {
            scenarioCoverStatus.textContent =
              `${file.name} · ${formatBytes(
                file.size
              )}`;
          }
        }
      );

      uploadScenarioCover?.addEventListener(
        "click",
        async () => {
          const file =
            scenarioCoverFile.files?.[0];

          if (
            !file ||
            !adminToken
          ) {
            return;
          }

          uploadScenarioCover.disabled =
            true;

          uploadScenarioCover.textContent =
            "Uploading...";

          scenarioCoverStatus.textContent =
            "Uploading custom scenario cover...";

          const formData =
            new FormData();

          formData.append(
            "scenario",
            scenarioSelect.value
          );

          formData.append(
            "file",
            file
          );

          try {
            const response =
              await fetch(
                "/api/admin/scenario-cover-upload",
                {
                  method: "POST",

                  headers: {
                    Authorization:
                      `Bearer ${adminToken}`,
                  },

                  body: formData,
                }
              );

            if (!response.ok) {
              const data =
                await response.json();

              throw new Error(
                data.message ||
                  "Upload failed."
              );
            }

            scenarioCoverFile.value =
              "";

            scenarioCoverStatus.textContent =
              "Scenario cover updated.";

            uploadScenarioCover.textContent =
              "Upload Cover";

            await loadImages();
          } catch (error) {
            scenarioCoverStatus.textContent =
              error.message;

            uploadScenarioCover.disabled =
              false;

            uploadScenarioCover.textContent =
              "Upload Cover";
          }
        }
      );

      function updateSelectedFiles() {
        const files =
          Array.from(
            fileInput.files || []
          );

        selectedFiles.innerHTML = "";

        files.forEach((file) => {
          const item =
            document.createElement(
              "div"
            );

          item.textContent =
            `${file.name} · ${formatBytes(
              file.size
            )}`;

          selectedFiles.appendChild(
            item
          );
        });

        uploadButton.disabled =
          files.length === 0;
      }

      fileInput.addEventListener(
        "change",
        updateSelectedFiles
      );

      if (uploadArea) {
        [
          "dragenter",
          "dragover",
        ].forEach((eventName) => {
          uploadArea.addEventListener(
            eventName,
            (event) => {
              event.preventDefault();

              uploadArea.classList.add(
                "dragging"
              );
            }
          );
        });

        [
          "dragleave",
          "drop",
        ].forEach((eventName) => {
          uploadArea.addEventListener(
            eventName,
            (event) => {
              event.preventDefault();

              uploadArea.classList.remove(
                "dragging"
              );
            }
          );
        });

        uploadArea.addEventListener(
          "drop",
          (event) => {
            const droppedFiles =
              Array.from(
                event.dataTransfer?.files ||
                  []
              ).filter((file) =>
                file.type.startsWith(
                  "image/"
                )
              );

            if (
              droppedFiles.length === 0
            ) {
              uploadStatus.textContent =
                "Please drop image files only.";

              return;
            }

            const transfer =
              new DataTransfer();

            droppedFiles.forEach(
              (file) => {
                transfer.items.add(file);
              }
            );

            fileInput.files =
              transfer.files;

            uploadStatus.textContent = "";

            updateSelectedFiles();
          }
        );
      }

      uploadButton.addEventListener(
        "click",
        uploadFiles
      );

      saveOrderButton.addEventListener(
        "click",
        async () => {
          const rows =
            Array.from(
              imageList.querySelectorAll(
                ".image-row[data-key]"
              )
            );

          const keys =
            rows.map(
              (row) =>
                row.dataset.key
            );

          saveOrderButton.disabled =
            true;

          saveOrderButton.textContent =
            "Saving...";

          try {
            const response =
              await fetch(
                "/api/admin/reorder",
                {
                  method: "POST",

                  headers: {
                    Authorization:
                      `Bearer ${adminToken}`,

                    "Content-Type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      scenario:
                        scenarioSelect.value,

                      gallery:
                        gallerySelect.value,

                      keys,
                    }),
                }
              );

            if (!response.ok) {
              throw new Error(
                "Could not save order."
              );
            }

            listStatus.textContent =
              "Image order saved.";

            saveOrderButton.textContent =
              "Save Order";
          } catch {
            listStatus.textContent =
              "Could not save image order.";

            saveOrderButton.disabled =
              false;

            saveOrderButton.textContent =
              "Save Order";
          }
        }
      );

      logoutButton?.addEventListener(
        "click",
        () => {
          sessionStorage.removeItem(
            "scenarioGalleryAdminToken"
          );

          adminToken = "";

          tokenInput.value = "";

          loginStatus.textContent = "";

          uploadStatus.textContent = "";

          imageList.innerHTML = "";

          adminTools.hidden = true;
          loginPanel.hidden = false;

          tokenInput.focus();
        }
      );

      populateGalleries();

      if (adminToken) {
        unlockAdmin(adminToken);
      }
    </script>
  </body>
</html>

