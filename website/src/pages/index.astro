---
import { scenarios } from "../data/scenarios.js";
import { site } from "../data/site.js";
import "../styles/theme.css";

function getScenarioImageCount(scenario) {
  return scenario.galleries.reduce(
    (total, gallery) => total + gallery.images.length,
    0
  );
}

function getScenarioCover(scenario) {
  for (const gallery of scenario.galleries) {
    if (gallery.images.length > 0) {
      return gallery.images[0];
    }
  }

  return null;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Browse FictionLab scenario artwork and character galleries."
    />

    <title>{site.name}</title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">
        {site.name}
      </a>

      <nav class="header-actions">
        <a href="/" class="nav-link">
          Scenarios
        </a>

        <div class="creator-badge">
          <img
            src={site.avatar}
            alt={`${site.creator} avatar`}
            class="creator-avatar"
          />

          <span>{site.creator}</span>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
      <div class="hero-fireflies" aria-hidden="true">
  <span class="firefly firefly-1"></span>
  <span class="firefly firefly-2"></span>
  <span class="firefly firefly-3"></span>
  <span class="firefly firefly-4"></span>
  <span class="firefly firefly-5"></span>
  <span class="firefly firefly-6"></span>
</div>

        <p class="eyebrow">
          FICTIONLAB VISUAL ARCHIVE
        </p>

        <h1>{site.name}</h1>

        <p class="intro">
          {site.tagline}
        </p>

        <div class="hero-creator">
          <img
            src={site.avatar}
            alt=""
            class="hero-avatar"
          />

          <div>
            <span class="hero-by">Gallery by</span>
            <span class="hero-name">{site.creator}</span>
          </div>
        </div>
      </section>

      <section class="scenario-section">
        <div class="section-heading">
          <h2>Scenarios</h2>

          <span>
            {scenarios.length}
            {" "}
            {scenarios.length === 1
              ? "scenario"
              : "scenarios"}
          </span>
        </div>

        <div class="scenario-grid">
          {
            scenarios.map((scenario) => {
              const totalImages =
                getScenarioImageCount(scenario);

              const cover =
                getScenarioCover(scenario);

              return (
                <a
                  class="scenario-card"
                  href={`/scenarios/${scenario.slug}`}
                >
                  <div class="cover">
  {
    cover ? (
      <img
        src={cover.src}
        alt={scenario.title}
        loading="lazy"
      />
    ) : (
      <span>
        No images yet
      </span>
    )
  }

  <div class="cover-overlay"></div>

  <div class="cover-badge">
    <span class="badge-dot"></span>

    {scenario.galleries.length}
    {" "}
    {scenario.galleries.length === 1
      ? "album"
      : "albums"}
  </div>
</div>

                  <div class="card-content">
                    <h3>
                      {scenario.title}
                    </h3>

                    <p>
                      {scenario.description}
                    </p>

                    <div class="card-meta">
                      <span>
                        {scenario.galleries.length}
                        {" "}
                        {scenario.galleries.length === 1
                          ? "album"
                          : "albums"}
                      </span>

                      <span>•</span>

                      <span>
                        {totalImages}
                        {" "}
                        {totalImages === 1
                          ? "image"
                          : "images"}
                      </span>
                    </div>

                    <span class="view-link">
                      View scenario →
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>
    </main>

    <footer class="site-footer">
  <div class="footer-left">
    <img
      src={site.mascot}
      alt=""
      class="footer-cat"
    />

    <div>
      <p class="footer-name">
        {site.name}
      </p>

      <p class="footer-credit">
        Gallery by {site.creator}
      </p>
    </div>
  </div>

  <p class="footer-note">
    ✦ made with stories, starlight & cat supervision
  </p>
</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #0b0b0c;
    color: #f5f5f5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    min-height: 76px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom:
      1px solid #252527;
  }

  .logo {
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    color: var(--text-muted);

    font-size: 0.88rem;

    transition:
      color 0.2s ease,
      text-shadow 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-main);

    text-shadow:
      0 0 12px
      rgba(164, 135, 255, 0.4);
  }

  .creator-badge {
    display: flex;
    align-items: center;

    gap: 9px;

    padding:
      6px 11px 6px 6px;

    border:
      1px solid
      var(--border-soft);

    border-radius: 999px;

    background:
      rgba(8, 19, 48, 0.58);

    backdrop-filter:
      blur(12px);

    color:
      var(--text-soft);

    font-size: 0.82rem;
    font-weight: 600;

    box-shadow:
      0 0 0
      rgba(159, 126, 255, 0);

    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .creator-badge:hover {
    border-color:
      rgba(174, 147, 255, 0.48);

    background:
      rgba(16, 28, 67, 0.75);

    box-shadow:
      0 0 22px
      rgba(133, 104, 255, 0.15);
  }

  .creator-avatar {
    display: block;

    width: 32px;
    height: 32px;

    object-fit: cover;

    border-radius: 50%;

    border:
      1px solid
      rgba(195, 183, 255, 0.4);

    box-shadow:
      0 0 12px
      rgba(144, 123, 255, 0.18);
  }

  main {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;
  }

  .hero {
  position: relative;

  max-width: 820px;

  padding:
    110px 0 100px;
}

.hero::before {
  content: "";

  position: absolute;

  width: 520px;
  height: 360px;

  left: -150px;
  top: 15px;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse,
      rgba(69, 111, 255, 0.19),
      rgba(110, 66, 210, 0.11) 45%,
      transparent 72%
    );

  filter: blur(22px);

  z-index: -1;
}

  .hero-fireflies {
    position: absolute;
    inset: 0;

    pointer-events: none;

    overflow: visible;
  }

  .firefly {
    position: absolute;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #fff1a6;

    box-shadow:
      0 0 6px #fff1a6,
      0 0 14px rgba(255, 224, 112, 0.8),
      0 0 28px rgba(157, 130, 255, 0.35);

    opacity: 0.7;

    animation:
      firefly-float 6s ease-in-out infinite,
      firefly-glow 2.8s ease-in-out infinite alternate;
  }

  .firefly-1 {
    top: 18%;
    left: 6%;
    animation-delay: -1s;
  }

  .firefly-2 {
    top: 30%;
    left: 88%;
    animation-delay: -3s;
  }

  .firefly-3 {
    top: 67%;
    left: 12%;
    animation-delay: -4.5s;
  }

  .firefly-4 {
    top: 76%;
    left: 72%;
    animation-delay: -2s;
  }

  .firefly-5 {
    top: 9%;
    left: 60%;

    width: 3px;
    height: 3px;

    animation-delay: -5s;
  }

  .firefly-6 {
    top: 55%;
    left: 96%;

    width: 4px;
    height: 4px;

    animation-delay: -0.5s;
  }

  @keyframes firefly-float {
    0% {
      transform:
        translate(0, 0);
    }

    35% {
      transform:
        translate(10px, -12px);
    }

    70% {
      transform:
        translate(-6px, 8px);
    }

    100% {
      transform:
        translate(0, 0);
    }
  }

  @keyframes firefly-glow {
    0% {
      opacity: 0.3;
      filter: brightness(0.8);
    }

    100% {
      opacity: 1;
      filter: brightness(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .firefly {
      animation: none;
    }
  }

  .eyebrow {
  margin: 0 0 18px;

  color: #b2a6ff;

  font-size: 0.7rem;
  font-weight: 750;

  letter-spacing: 0.2em;

  text-shadow:
    0 0 12px
    rgba(157, 129, 255, 0.35);
}

  h1 {
    margin: 0;

    font-size:
      clamp(3rem, 8vw, 6.5rem);

    line-height: 0.95;
    letter-spacing: -0.055em;

    background:
      linear-gradient(
        105deg,
        #ffffff 5%,
        #c8dcff 38%,
        #cbb9ff 68%,
        #ffffff 100%
      );

    background-clip: text;
    -webkit-background-clip: text;

    color: transparent;

    filter:
      drop-shadow(
        0 0 18px
        rgba(137, 134, 255, 0.22)
      );
  }

  .intro {
    max-width: 600px;

    margin: 30px 0 0;

    color: var(--text-soft);  

    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-creator {
  display: inline-flex;
  align-items: center;

  gap: 20px;

  margin-top: 38px;
}

.hero-avatar {
  display: block;

  width: 110px;
  height: 110px;

  object-fit: cover;

  border-radius: 50%;

  border:
    2px solid
    rgba(201, 185, 255, 0.55);

  box-shadow:
    0 0 20px
    rgba(145, 115, 255, 0.35),
    0 0 40px
    rgba(91, 120, 255, 0.16);
}

.hero-creator > div {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.hero-by {
  color: var(--text-muted);

  font-size: 0.95rem;
  font-weight: 650;

  text-transform: uppercase;
  letter-spacing: 0.13em;
}

.hero-name {
  color: #e3dcff;

  font-size: 1.6rem;
  font-weight: 750;

  text-shadow:
    0 0 14px
    rgba(164, 137, 255, 0.3);
}

  .scenario-section {
    padding-bottom: 110px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;

    padding-bottom: 18px;
    margin-bottom: 28px;

    border-bottom:
      1px solid #252527;
  }

  .section-heading h2 {
    margin: 0;

    font-size: 1.35rem;
  }

  .section-heading span {
    color: var(--text-muted);

    font-size: 0.85rem;
  }

  .scenario-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .scenario-card {
    overflow: hidden;

    border:
      1px solid
      var(--border-soft);

    border-radius: 18px;

    background:
      linear-gradient(
        145deg,
        rgba(16, 31, 70, 0.9),
        rgba(8, 14, 38, 0.88)
      );

    box-shadow:
      0 18px 45px
      rgba(0, 0, 20, 0.25);

    backdrop-filter: blur(14px);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .scenario-card:hover {
  transform: translateY(-5px);

  border-color:
    var(--border-glow);

  box-shadow:
    0 20px 55px
      rgba(28, 40, 110, 0.32),
    0 0 30px
      rgba(146, 112, 255, 0.13);
}

  .cover {
  position: relative;

  aspect-ratio: 16 / 10;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      rgba(19, 39, 89, 0.9),
      rgba(7, 12, 34, 0.95)
    );

  border-bottom:
    1px solid var(--border-soft);

  color: var(--text-muted);

  font-size: 0.82rem;
}

  .cover img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transform: scale(1);

  filter:
    brightness(0.92)
    saturate(1.03);

  transition:
    transform 0.5s ease,
    filter 0.5s ease;
}

  .scenario-card:hover .cover img {
    transform: scale(1.035);

    filter:
      brightness(1.02)
      saturate(1.08);
  }

  .cover-overlay {
    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      linear-gradient(
        180deg,
        transparent 45%,
        rgba(5, 10, 31, 0.25) 68%,
        rgba(8, 12, 38, 0.78) 100%
      );

    transition:
      opacity 0.3s ease;
  }

  .cover-badge {
    position: absolute;

    left: 14px;
    bottom: 14px;

    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 7px 10px;

    border:
      1px solid
      rgba(192, 179, 255, 0.22);

    border-radius: 999px;

    background:
      rgba(6, 13, 39, 0.66);

    backdrop-filter:
      blur(12px);

    color: #ddd7ff;

    font-size: 0.72rem;
    font-weight: 650;

    box-shadow:
      0 0 18px
      rgba(113, 87, 255, 0.12);
  }

  .badge-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #d7c8ff;

    box-shadow:
      0 0 6px #ad94ff,
      0 0 12px
      rgba(123, 153, 255, 0.65);
  }

  .card-content {
    padding: 22px;
  }

  .card-content h3 {
    margin: 0;

    font-size: 1.2rem;
    line-height: 1.3;

    transition:
      color 0.25s ease,
      text-shadow 0.25s ease;
  }

  .scenario-card:hover .card-content h3 {
    color: #ffffff;

    text-shadow:
      0 0 14px
      rgba(160, 137, 255, 0.18);
  }

  .card-content > p {
    margin: 12px 0 22px;

    color: var(--text-muted);

    font-size: 0.9rem;
    line-height: 1.55;
  }

  .card-meta {
    display: flex;
    gap: 8px;

    margin-bottom: 22px;

    color: var(--text-muted);

    font-size: 0.8rem;
  }

 .view-link {
  display: inline-block;

  color: #c9bcff;

  font-size: 0.88rem;
  font-weight: 650;

  text-shadow:
    0 0 10px
    rgba(161, 132, 255, 0.22);
}

  .site-footer {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 32px 0 44px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 28px;

    border-top:
      1px solid var(--border-soft);
  }

  .footer-left {
    display: flex;
    align-items: center;

    gap: 12px;
  }

  .footer-cat {
    display: block;

    width: 48px;
    height: 48px;

    object-fit: contain;

    filter:
      drop-shadow(
        0 0 12px
        rgba(147, 120, 255, 0.24)
      );
  }

  .footer-name {
    margin: 0;

    color: var(--text-soft);

    font-size: 0.82rem;
    font-weight: 700;
  }

  .footer-credit {
    margin: 3px 0 0;

    color: var(--text-muted);

    font-size: 0.72rem;
  }

  .footer-note {
    margin: 0;

    color: var(--text-muted);

    font-size: 0.72rem;

    letter-spacing: 0.04em;
  }

  @media (max-width: 850px) {
    .scenario-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .site-header,
    main,
    footer {
      width: calc(100% - 28px);
    }

    .site-header {
      min-height: 66px;
    }

    .hero {
      padding:
        72px 0 65px;
    }

    .scenario-grid {
      grid-template-columns: 1fr;
    }

    .header-actions {
      gap: 10px;
    }

    .nav-link {
      display: none;
    }

    .creator-badge {
      padding:
        4px 8px 4px 4px;
    }

    .creator-avatar {
      width: 30px;
      height: 30px;
    }

    .creator-badge span {
      font-size: 0.76rem;
    }

    .firefly-2,
    .firefly-6 {
      display: none;
    }

    .firefly {
      transform: scale(0.85);
    }

    .hero-avatar {
      width: 90px;
      height: 90px;
    }

    .hero-by {
      font-size: 0.8rem;
    }

    .hero-name {
      font-size: 1.35rem;
    }

    .hero-creator {
      gap: 16px;
    }

    .site-footer {
      width: calc(100% - 28px);

      flex-direction: column;
      align-items: flex-start;

      gap: 18px;
    }

    .footer-cat {
      width: 44px;
      height: 44px;
    }

    .footer-note {
      max-width: 260px;
    }
  }
</style>