---
import { scenarios } from "../data/scenarios.js";
import { site } from "../data/site.js";

function getScenarioImageCount(scenario) {
  return scenario.galleries.reduce(
    (total, gallery) => total + gallery.images.length,
    0
  );
}

function getScenarioCover(scenario) {
  for (const gallery of scenario.galleries) {
    if (gallery.images.length > 0) {
      return gallery.images[0];
    }
  }

  return null;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Browse FictionLab scenario artwork and character galleries."
    />

    <title>{site.name}</title>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo">
        {site.name}
      </a>

      <nav>
        <a href="/">Scenarios</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">
          FICTIONLAB ART ARCHIVE
        </p>

        <h1>{site.name}</h1>

        <p class="intro">
          {site.tagline}
        </p>
      </section>

      <section class="scenario-section">
        <div class="section-heading">
          <h2>Scenarios</h2>

          <span>
            {scenarios.length}
            {" "}
            {scenarios.length === 1
              ? "scenario"
              : "scenarios"}
          </span>
        </div>

        <div class="scenario-grid">
          {
            scenarios.map((scenario) => {
              const totalImages =
                getScenarioImageCount(scenario);

              const cover =
                getScenarioCover(scenario);

              return (
                <a
                  class="scenario-card"
                  href={`/scenarios/${scenario.slug}`}
                >
                  <div class="cover">
                    {
                      cover ? (
                        <img
                          src={cover.src}
                          alt={scenario.title}
                          loading="lazy"
                        />
                      ) : (
                        <span>
                          No images yet
                        </span>
                      )
                    }
                  </div>

                  <div class="card-content">
                    <h3>
                      {scenario.title}
                    </h3>

                    <p>
                      {scenario.description}
                    </p>

                    <div class="card-meta">
                      <span>
                        {scenario.galleries.length}
                        {" "}
                        {scenario.galleries.length === 1
                          ? "album"
                          : "albums"}
                      </span>

                      <span>•</span>

                      <span>
                        {totalImages}
                        {" "}
                        {totalImages === 1
                          ? "image"
                          : "images"}
                      </span>
                    </div>

                    <span class="view-link">
                      View scenario →
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>
    </main>

    <footer>
      <p>{site.name} · {site.creator}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    background: #0b0b0c;
    color: #f5f5f5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 50% -10%,
        rgba(255,255,255,0.07),
        transparent 35rem
      ),
      #0b0b0c;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    min-height: 76px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom:
      1px solid #252527;
  }

  .logo {
    font-size: 0.83rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  nav a {
    color: #aaa;
    font-size: 0.9rem;
  }

  main {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;
  }

  .hero {
    max-width: 760px;

    padding:
      100px 0 90px;
  }

  .eyebrow {
    margin: 0 0 18px;

    color: #8d8d91;

    font-size: 0.72rem;
    font-weight: 700;

    letter-spacing: 0.2em;
  }

  h1 {
    margin: 0;

    font-size:
      clamp(3rem, 8vw, 6.5rem);

    line-height: 0.95;

    letter-spacing: -0.055em;
  }

  .intro {
    max-width: 600px;

    margin: 30px 0 0;

    color: #a7a7ab;

    font-size: 1.05rem;
    line-height: 1.7;
  }

  .scenario-section {
    padding-bottom: 110px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;

    padding-bottom: 18px;
    margin-bottom: 28px;

    border-bottom:
      1px solid #252527;
  }

  .section-heading h2 {
    margin: 0;

    font-size: 1.35rem;
  }

  .section-heading span {
    color: #77777c;

    font-size: 0.85rem;
  }

  .scenario-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 24px;
  }

  .scenario-card {
    overflow: hidden;

    border:
      1px solid #28282b;

    border-radius: 16px;

    background: #111113;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .scenario-card:hover {
    transform:
      translateY(-4px);

    border-color: #55555b;
  }

  .cover {
    aspect-ratio: 16 / 10;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #171719;

    border-bottom:
      1px solid #28282b;

    color: #68686d;

    font-size: 0.82rem;
  }

  .cover img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .card-content {
    padding: 22px;
  }

  .card-content h3 {
    margin: 0;

    font-size: 1.2rem;
    line-height: 1.3;
  }

  .card-content > p {
    margin: 12px 0 22px;

    color: #8f8f94;

    font-size: 0.9rem;
    line-height: 1.55;
  }

  .card-meta {
    display: flex;
    gap: 8px;

    margin-bottom: 22px;

    color: #68686d;

    font-size: 0.8rem;
  }

  .view-link {
    display: inline-block;

    font-size: 0.88rem;
    font-weight: 650;
  }

  footer {
    width: min(
      1200px,
      calc(100% - 40px)
    );

    margin: 0 auto;

    padding: 28px 0 50px;

    border-top:
      1px solid #252527;

    color: #68686d;

    font-size: 0.8rem;
  }

  @media (max-width: 850px) {
    .scenario-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .site-header,
    main,
    footer {
      width: calc(100% - 28px);
    }

    .site-header {
      min-height: 66px;
    }

    .hero {
      padding:
        72px 0 65px;
    }

    .scenario-grid {
      grid-template-columns: 1fr;
    }
  }
</style>