{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "scenario-galleries",

  "compatibility_date": "2026-08-17",

  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "r2_buckets": [
    {
      "binding": "GALLERY_IMAGES",
      "bucket_name": "scenario-gallery-images"
    }
  ]
}